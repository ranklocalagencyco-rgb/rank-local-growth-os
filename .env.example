# Runtime
NODE_ENV=development
APP_ENV=local
SEND_MODE=disabled

# Supabase public client config (safe to expose to browser code)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional observability
SENTRY_DSN=

# Local workspace defaults
LOCAL_WORKSPACE_ID=11111111-1111-4111-8111-111111111111
LOCAL_OWNER_USER_ID=22222222-2222-4222-8222-222222222222

# Background jobs (server-side only)
# Shared secret for POST /api/jobs/run; the worker script and any cron trigger send it as a bearer token.
JOB_RUNNER_SECRET=
# Base URL the worker script calls
APP_URL=http://localhost:3000

# Business discovery (server-side only; never exposed to the browser)
# dataforseo (default): Google Maps listings via the DataForSEO SERP API; website/phone arrive with the search, no per-candidate enrichment.
# google_places: optional fallback using the Places API (New); needs GOOGLE_PLACES_API_KEY and uses two-stage enrichment below.
DISCOVERY_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DataForSEO execution mode for discovery searches:
#   standard (default) - cheapest ($0.0006/page); task is queued and the worker retrieves it later (typically minutes). Use for automated background discovery.
#   priority           - queued with faster turnaround ($0.0012/page).
#   live               - synchronous answer in seconds ($0.002/page). Use for manual/on-demand runs.
# Purge re-fetches (My Business Info) are always live. Output is normalised identically in every mode.
DATAFORSEO_MODE=standard
# Maps results requested per category x location (20-700, default 100; DataForSEO bills each 100 results as one page and has no page cursor)
DATAFORSEO_MAPS_DEPTH=100
# Optional: DataForSEO location_code override (otherwise derived from the campaign country, e.g. GB -> 2826)
DATAFORSEO_LOCATION_CODE=
# Only required when DISCOVERY_PROVIDER=google_places
GOOGLE_PLACES_API_KEY=
# Provider content retention for discovery candidates (place IDs are kept; other content is purged after this many hours)
DISCOVERY_CANDIDATE_TTL_HOURS=24
# Google Places only: cap on Text Search pages per category x location pair (20 results per page). DataForSEO uses DATAFORSEO_MAPS_DEPTH instead.
DISCOVERY_MAX_PAGES_PER_QUERY=2
# Candidate cap per run when the campaign has no daily_candidate_cap
DISCOVERY_DEFAULT_CANDIDATE_CAP=60
# Hard cap on billable provider requests in one discovery run (campaign settings_json.max_requests_per_run may lower it, never raise it)
DISCOVERY_MAX_REQUESTS_PER_RUN=50
# How long a queued (standard/priority) provider task may stay pending before the run is failed
DISCOVERY_TASK_TIMEOUT_MINUTES=120
# Google Places only. two_stage (default): Text Search requests identity fields only; website/phone are fetched per surviving candidate via Place Details.
# inline: Text Search requests website/phone directly (Enterprise tier per page) and no Place Details calls are made.
DISCOVERY_ENRICHMENT_MODE=two_stage

# Website audit crawler (our own deterministic crawler; no provider crawls websites for us)
# Hard cap on pages fetched per audit (1-50). A single audit never crawls a whole site.
AUDIT_MAX_PAGES=15
# Per-request timeout, response byte cap and redirect cap enforced by the SSRF-safe fetcher
AUDIT_REQUEST_TIMEOUT_MS=10000
AUDIT_MAX_RESPONSE_BYTES=2000000
AUDIT_MAX_REDIRECTS=5

# Performance evidence (homepage only in V1; runs as a background job after the website audit, never in a request)
# pagespeed (default): Google PageSpeed Insights API v5. none: skip performance; the audit score marks it not evaluated.
PERFORMANCE_PROVIDER=pagespeed
# Strategies measured per audit: mobile, desktop or both. One provider request per strategy on the happy path.
PERFORMANCE_STRATEGIES=mobile,desktop
# Hard cap on provider requests for one audit run, retries included (1-10). Each strategy is tried at most twice.
PERFORMANCE_MAX_REQUESTS_PER_RUN=4
# Timeout of one provider request in ms (5000-38000). A single analysis commonly takes 15-40 seconds.
PERFORMANCE_REQUEST_TIMEOUT_MS=35000
# Optional. PageSpeed Insights is currently available without an API key; a key is recommended for frequent automated use.
# Quotas and rate limits depend on the Google project/authentication in use: treat them as configuration, not as application
# assumptions. A rate-limited request is retried and then recorded as a failed observation; it never fails the website audit.
PAGESPEED_API_KEY=
