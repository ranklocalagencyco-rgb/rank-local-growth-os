# Runtime
NODE_ENV=development
APP_ENV=local
SEND_MODE=disabled

# Supabase (server-only; optional for local boot and unit tests)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional observability
SENTRY_DSN=

# Local workspace defaults
LOCAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
LOCAL_OWNER_USER_ID=00000000-0000-0000-0000-000000000002
